{
    "name": "cleveregg-digital/shorthand-time",
    "description": "A simple PHP package for time unit conversions with an intuitive enum-based API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "CleverEgg Digital",
            "email": "dev@cleveregg.digital"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pcov": "For code coverage support (recommended for CI)",
        "ext-xdebug": "Alternative coverage driver (slower than pcov)"
    },
    "autoload": {
        "psr-4": {
            "CleverEggDigital\\ShorthandTime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleverEggDigital\\ShorthandTime\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage --coverage-text --coverage-clover coverage/clover.xml",
        "analyse": "phpstan analyse",
        "infection": "XDEBUG_MODE=coverage infection --threads=4",
        "ci": [
            "@analyse",
            "@test:coverage",
            "@infection"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable"
}
